{
  "name": "daybreak-alarm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "worker:dev": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply daybreak --local",
    "db:remote": "wrangler d1 migrations apply daybreak --remote"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "hono": "^4.10.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.12",
    "wrangler": "^4.45.0"
  }
}
